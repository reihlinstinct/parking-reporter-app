<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only (the CI emulator job runs debug): the instrumented
         E2E test serves its stub municipal API from the device loopback.
         The release manifest keeps cleartext fully forbidden and declares no
         networkSecurityConfig; MainManifestGuardTest fails CI if that ever
         changes. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
